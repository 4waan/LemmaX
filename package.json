{
  "name": "lemmax",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node examples/assess.mjs",
    "demo:billing": "node examples/billing.mjs",
    "benchmark:verify": "node scripts/verify-scifact.mjs && node scripts/verify-retrieval.mjs",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "demo:retrieval": "node examples/retrieval.mjs",
    "demo:attempt": "node examples/attempt.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "mcp:check": "node scripts/smoke-mcp.mjs",
    "contract:compile": "node scripts/compile-settlement.mjs",
    "contract:abi": "node scripts/compile-settlement.mjs --write-abi",
    "settlement:check": "node scripts/settlement-check.mjs",
    "settlement:fork-check": "node scripts/settlement-fork-check.mjs",
    "deploy:settlement": "node scripts/deploy-settlement.mjs",
    "demo:testnet": "node scripts/testnet-demo.mjs",
    "auditor:test": "npm --prefix indexer test",
    "privy:kill-test": "node scripts/privy-kill-test.mjs",
    "privy:setup": "node scripts/privy-setup.mjs",
    "agents:register": "node scripts/register-agents.mjs",
    "reputation": "node scripts/publish-reputation.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@privy-io/node": "0.35.0",
    "viem": "2.57.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "solc": "0.8.37"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
